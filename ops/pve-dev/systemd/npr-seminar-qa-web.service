# QA 서버 Next.js web. 127.0.0.1:3100 에서 수신하고 frontdoor 가 3000 으로 노출함
[Unit]
Description=NPR Seminar QA Next.js web on 3100
After=network-online.target npr-seminar-qa-api.service
Wants=network-online.target npr-seminar-qa-api.service

[Service]
Type=simple
User=ken
Group=ken
WorkingDirectory=/home/ken/develop/npr-seminar/apps/web
EnvironmentFile=/etc/npr-seminar-qa/web.env
Environment=NODE_ENV=production
# 빌드 산출물이 없으면 시작하지 않음
ExecStartPre=/usr/bin/test -f /home/ken/develop/npr-seminar/apps/web/.next/BUILD_ID
ExecStart=/usr/bin/node /home/ken/develop/npr-seminar/apps/web/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
UMask=0027
# 샌드박스. Next 캐시만 쓰기 허용
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ken/develop/npr-seminar/apps/web/.next/cache
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
