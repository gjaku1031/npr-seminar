PROCESS_ROLE=api
PORT=4000
DATABASE_URL=
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
PHONE_ENCRYPTION_KEY=
PHONE_HMAC_KEY=
OTP_PEPPER=
SCANNER_PAIRING_HMAC_KEY=
QR_ENCRYPTION_KEY=
ALIGO_IDENTIFIER=
ALIGO_KEY=
SMS_ENABLED=false
SMS_RECIPIENT_ALLOWLIST_ENABLED=true
SMS_TEST_RECIPIENTS=
SMS_SENDER_SONGPA=
SMS_SENDER_WIRYE=
SMS_SENDER_GWANGJIN=
SMS_ALIGO_TEST_MODE=true
GOOGLE_SHEETS_ENABLED=false
# Development-only escape hatch. This waives only `anyone:writer`; all other sharing and service-account checks remain enforced.
GOOGLE_SHEETS_ALLOW_PUBLIC_WRITER_IN_DEVELOPMENT=false
GOOGLE_SHEETS_SPREADSHEET_ID=1hOYWwKHpk_tchht6MVQ1dEwoW9iT7qJbzQRlLXUKpP0
GOOGLE_APPLICATION_CREDENTIALS=
PUBLIC_BASE_URL=
TRUST_PROXY=0
TONG_SYNC_ENABLED=false
# Keep false until the operator has confirmed the exact upstream request/response contract.
TONG_WIRE_CONTRACT_CONFIRMED=false
TONG_WIRE_CONTRACT_JSON=
TONG_BASE_URL=
TONG_USERNAME=
TONG_PASSWORD=
# One-time/rotation command only. Prefer ADMIN_BOOTSTRAP_PASSWORD_FD over a persistent env secret.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_PASSWORD_FD=
