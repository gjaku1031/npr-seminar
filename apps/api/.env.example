# API·워커 환경 변수 예시. 실제 값은 넣지 않고 모든 비밀 값은 배포 비밀 저장소로 주입
# 실행 환경·프로세스 역할·포트
APP_ENV=local
PROCESS_ROLE=api
PORT=4000
# DB·Redis 연결. 워커와 마이그레이션은 별도 권한 계정 URL 사용
DATABASE_URL=
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
# 암호화·서명 키. 각각 base64 32바이트, 서로 다른 값
SESSION_SECRET=
PHONE_ENCRYPTION_KEY=
PHONE_HMAC_KEY=
OTP_PEPPER=
SCANNER_PAIRING_HMAC_KEY=
QR_ENCRYPTION_KEY=
# 알리고 문자 발송. 자격 증명은 워커 전용
ALIGO_IDENTIFIER=
ALIGO_KEY=
SMS_ENABLED=false
SMS_RECIPIENT_ALLOWLIST_ENABLED=true
SMS_TEST_RECIPIENTS=
SMS_SENDER_CAMPUS_A=
SMS_SENDER_CAMPUS_B=
SMS_SENDER_CAMPUS_C=
SMS_ALIGO_TEST_MODE=true
# Google Sheets 반영. 자격 증명은 워커 전용
GOOGLE_SHEETS_ENABLED=false
# 개발 환경 전용 예외. `anyone:writer` 공유만 허용하고 나머지 공유·서비스 계정 검사는 그대로 적용
GOOGLE_SHEETS_ALLOW_PUBLIC_WRITER_IN_DEVELOPMENT=false
GOOGLE_SHEETS_SPREADSHEET_ID=EXAMPLE_SHEET_ID_xxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_APPLICATION_CREDENTIALS=
# 공개 기준 URL·포스터 저장 위치·신뢰 프록시 단계
PUBLIC_BASE_URL=
POSTER_STORAGE_DIR=
TRUST_PROXY=0
# 통통통 학생 동기화
TONG_SYNC_ENABLED=false
# 운영자가 원천 요청·응답 계약을 정확히 확인하기 전까지 false 유지
TONG_WIRE_CONTRACT_CONFIRMED=false
TONG_WIRE_CONTRACT_JSON=
TONG_BASE_URL=
TONG_USERNAME=
TONG_PASSWORD=
# 관리자 계정 준비 명령 전용. 영구 환경 변수 비밀번호 대신 ADMIN_BOOTSTRAP_PASSWORD_FD 사용 권장
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_PASSWORD_FD=
