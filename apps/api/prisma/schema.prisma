/// 문자 발송 대기열
model SmsOutbox {
  /// ID
  id                     BigInt       @id @default(autoincrement())
  /// 공개 ID
  publicId               String       @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  /// 이벤트 키 SHA-256. 같은 이벤트 중복 적재 방지
  eventKeyDigest         Bytes        @unique @map("event_key_digest") @db.ByteA
  /// 발생 원인
  source                 String       @db.VarChar(40)
  /// 지점 코드
  branchCode             String       @map("branch_code") @db.VarChar(32)
  /// 회차 공개 ID
  seminarSessionPublicId String?      @map("seminar_session_public_id") @db.Uuid
  /// 가족 예약 공개 ID
  familyBookingPublicId  String?      @map("family_booking_public_id") @db.Uuid
  /// 수신 번호 암호문
  recipientCiphertext    Bytes        @map("recipient_ciphertext") @db.ByteA
  /// 수신 번호 다이제스트
  recipientDigest        Bytes        @map("recipient_digest") @db.ByteA
  /// 수신 번호 끝 4자리
  recipientLast4         String       @map("recipient_last4") @db.Char(4)
  /// 본문 암호문
  messageCiphertext      Bytes        @map("message_ciphertext") @db.ByteA
  /// 제목 암호문
  titleCiphertext        Bytes?       @map("title_ciphertext") @db.ByteA
  /// SMS·LMS
  messageType            String       @map("message_type") @db.VarChar(8)
  /// 본문 EUC-KR 바이트
  messageBytes           Int          @map("message_bytes")
  /// 제목 EUC-KR 바이트
  titleBytes             Int?         @map("title_bytes")
  /// PENDING·CLAIMED·SENDING·SENT·BLOCKED_*·FAILED_PERMANENT·DELIVERY_UNKNOWN·DEAD·CANCELLED
  status                 String       @default("PENDING") @db.VarChar(32)
  /// 시도 횟수
  attemptCount           Int          @default(0) @map("attempt_count")
  /// 발송 가능 시각. 예약 발송·재시도 지연
  nextAttemptAt          DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /// 워커 점유 토큰
  leaseToken             String?      @map("lease_token") @db.Uuid
  /// lease 만료 시각
  leaseExpiresAt         DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  /// 공급자 메시지 ID
  providerMessageId      String?      @map("provider_message_id") @db.VarChar(80)
  /// 공급자 결과 코드
  providerResultCode     Int?         @map("provider_result_code")
  /// 공급자 메시지 유형
  providerMessageType    String?      @map("provider_message_type") @db.VarChar(16)
  /// 마지막 오류 코드
  lastErrorCode          String?      @map("last_error_code") @db.VarChar(80)
  /// 처리 주체. 관리자 공개 ID 또는 `system:` 주체
  actorSubject           String?      @map("actor_subject") @db.VarChar(160)
  /// 개인정보 없는 부가 정보
  safeMetadata           Json         @default("{}") @map("safe_metadata") @db.JsonB
  /// 생성 시각
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 변경 시각
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 시도 기록
  attempts               SmsAttempt[]

  @@index([status, nextAttemptAt, id], map: "sms_outbox_worker_idx")
  @@index([seminarSessionPublicId, createdAt(sort: Desc)], map: "sms_outbox_session_created_idx")
  @@index([familyBookingPublicId, createdAt(sort: Desc)], map: "sms_outbox_family_created_idx")
  @@index([recipientDigest, createdAt(sort: Desc)], map: "sms_outbox_recipient_created_idx")
  @@map("sms_outbox")
}

/// 문자 발송 시도 기록
model SmsAttempt {
  /// ID
  id                 BigInt    @id @default(autoincrement())
  /// 이벤트 공개 ID
  eventId            String    @unique @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  /// 대기열 행 ID
  smsOutboxId        BigInt    @map("sms_outbox_id")
  /// 시도 번호
  attemptNo          Int       @map("attempt_no")
  /// 결과
  result             String    @db.VarChar(32)
  /// 공급자 결과 코드
  providerResultCode Int?      @map("provider_result_code")
  /// 공급자 메시지 ID
  providerMessageId  String?   @map("provider_message_id") @db.VarChar(80)
  /// 오류 코드
  errorCode          String?   @map("error_code") @db.VarChar(80)
  /// 개인정보 없는 부가 정보
  safeMetadata       Json      @default("{}") @map("safe_metadata") @db.JsonB
  /// 발생 시각
  occurredAt         DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// 대기열 행
  outbox             SmsOutbox @relation(fields: [smsOutboxId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([smsOutboxId, attemptNo], map: "sms_attempts_outbox_attempt_unique")
  @@index([smsOutboxId, occurredAt(sort: Desc)], map: "sms_attempts_outbox_occurred_idx")
  @@map("sms_attempts")
}

/// 회차별 Google Sheets 반영 매핑
model SheetMapping {
  /// ID
  id                     BigInt        @id @default(autoincrement())
  /// 공개 ID
  publicId               String        @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  /// 회차 공개 ID
  seminarSessionPublicId String        @unique @map("seminar_session_public_id") @db.Uuid
  /// 스프레드시트 ID
  spreadsheetId          String        @map("spreadsheet_id") @db.VarChar(160)
  /// 예약명단 시트 제목
  reservationSheetTitle  String        @default("예약명단") @map("reservation_sheet_title") @db.VarChar(100)
  /// 예약명단 시트 ID
  reservationSheetId     Int           @default(1777564107) @map("reservation_sheet_id")
  /// 이전 로그 시트 제목. 현재 반영에서 사용하지 않음
  logSheetTitle          String        @default("예약로그") @map("log_sheet_title") @db.VarChar(100)
  /// 이전 로그 시트 ID. 현재 반영에서 사용하지 않음
  logSheetId             Int           @default(1787194666) @map("log_sheet_id")
  /// 이전 A 시트 ID. 현재 반영에서 사용하지 않음
  campusASheetId          Int           @default(0) @map("campus_a_sheet_id")
  /// 이전 B 시트 ID. 현재 반영에서 사용하지 않음
  campusBSheetId           Int           @default(470961226) @map("campus_b_sheet_id")
  /// 이전 C 시트 ID. 현재 반영에서 사용하지 않음
  campusCSheetId        Int           @default(1080132708) @map("campus_c_sheet_id")
  /// 시트 구조 지문
  schemaFingerprint      String        @map("schema_fingerprint") @db.VarChar(100)
  /// 시트 스키마 버전. 코드 상수와 같아야 반영
  schemaVersion          Int           @default(4) @map("schema_version")
  /// 반영 활성 여부
  enabled                Boolean       @default(false)
  /// CLOSED 반영 가능, BLOCKED 차단
  circuitStatus          String        @default("BLOCKED") @map("circuit_status") @db.VarChar(24)
  /// 차단 사유
  blockReasonCode        String?       @map("block_reason_code") @db.VarChar(80)
  /// 마지막 워커 검증 시각
  lastValidatedAt        DateTime?     @map("last_validated_at") @db.Timestamptz(6)
  /// 반영 lease 소유 토큰
  dispatchLeaseOwner     String?       @map("dispatch_lease_owner") @db.Uuid
  /// 반영 lease 만료 시각
  dispatchLeaseExpiresAt DateTime?     @map("dispatch_lease_expires_at") @db.Timestamptz(6)
  /// 마지막 반영 시각
  lastDispatchAt         DateTime?     @map("last_dispatch_at") @db.Timestamptz(6)
  /// 생성 시각
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 변경 시각
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 반영 대기열
  deliveries             SheetOutbox[]

  @@index([enabled, circuitStatus], map: "sheet_mappings_enabled_circuit_idx")
  @@map("sheet_mappings")
}

/// 시트 반영 대기열. 예약 학생 단위
model SheetOutbox {
  /// ID
  id                           BigInt         @id @default(autoincrement())
  /// 반영 공개 ID
  deliveryPublicId             String         @unique @default(dbgenerated("gen_random_uuid()")) @map("delivery_public_id") @db.Uuid
  /// 매핑 ID
  mappingId                    BigInt         @map("mapping_id")
  /// 예약 이벤트 ID
  eventId                      String         @map("event_id") @db.Uuid
  /// CREATED·UPDATED·CANCELLED·CHECKED_IN
  eventType                    String         @map("event_type") @db.VarChar(32)
  /// 회차 공개 ID
  seminarSessionPublicId       String         @map("seminar_session_public_id") @db.Uuid
  /// 가족 예약 공개 ID
  familyBookingPublicId        String         @map("family_booking_public_id") @db.Uuid
  /// 예약 학생 공개 ID
  familyBookingStudentPublicId String         @map("family_booking_student_public_id") @db.Uuid
  /// 학생 공개 ID. 비재원생은 예약 학생 ID
  studentPublicId              String         @map("student_public_id") @db.Uuid
  /// 이벤트 시점 예약 버전
  bookingVersion               BigInt         @map("booking_version")
  /// 반영 스냅샷 암호문
  snapshotCiphertext           Bytes          @map("snapshot_ciphertext") @db.ByteA
  /// PENDING·RETRY·CLAIMED·SUCCEEDED·BLOCKED·DEAD
  status                       String         @default("PENDING") @db.VarChar(24)
  /// 시도 횟수
  attemptCount                 Int            @default(0) @map("attempt_count")
  /// 다음 처리 가능 시각
  nextAttemptAt                DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  /// 점유 토큰. 매핑 lease와 같은 값
  leaseOwner                   String?        @map("lease_owner") @db.Uuid
  /// lease 만료 시각
  leaseExpiresAt               DateTime?      @map("lease_expires_at") @db.Timestamptz(6)
  /// 마지막 오류 코드
  lastErrorCode                String?        @map("last_error_code") @db.VarChar(80)
  /// 완료 시각
  completedAt                  DateTime?      @map("completed_at") @db.Timestamptz(6)
  /// 생성 시각
  createdAt                    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 변경 시각
  updatedAt                    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 시트 매핑
  mapping                      SheetMapping   @relation(fields: [mappingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 시도 기록
  attempts                     SheetAttempt[]

  @@unique([mappingId, eventId, familyBookingStudentPublicId], map: "sheet_outbox_mapping_event_child_unique")
  @@index([status, nextAttemptAt, id], map: "sheet_outbox_worker_idx")
  @@index([familyBookingPublicId, bookingVersion], map: "sheet_outbox_booking_version_idx")
  @@map("sheet_outbox")
}

/// 시트 반영 시도 기록
model SheetAttempt {
  /// ID
  id            BigInt      @id @default(autoincrement())
  /// 이벤트 공개 ID
  eventId       String      @unique @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  /// 대기열 행 ID
  sheetOutboxId BigInt      @map("sheet_outbox_id")
  /// 시도 번호
  attemptNo     Int         @map("attempt_no")
  /// 결과
  result        String      @db.VarChar(24)
  /// 오류 코드
  errorCode     String?     @map("error_code") @db.VarChar(80)
  /// 개인정보 없는 부가 정보
  safeMetadata  Json        @default("{}") @map("safe_metadata") @db.JsonB
  /// 발생 시각
  occurredAt    DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// 대기열 행
  outbox        SheetOutbox @relation(fields: [sheetOutboxId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sheetOutboxId, attemptNo], map: "sheet_attempts_outbox_attempt_unique")
  @@index([sheetOutboxId, occurredAt(sort: Desc)], map: "sheet_attempts_outbox_occurred_idx")
  @@map("sheet_attempts")
}
