/// QR 스캐너 기기
model ScannerDevice {
  /// ID
  id                BigInt                @id @default(autoincrement())
  /// 공개 ID
  publicId          String                @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  /// 지점 ID
  branchId          BigInt                @map("branch_id")
  /// 기기 이름
  name              String                @db.VarChar(120)
  /// 클라이언트 플랫폼
  model             String?               @db.VarChar(120)
  /// 설치 위치(입구 이름)
  location          String?               @db.VarChar(160)
  /// 출입구 코드
  gateCode          String                @map("gate_code") @db.VarChar(100)
  /// 배터리 잔량(%)
  batteryPercent    Int?                  @map("battery_percent")
  /// 충전 중 여부
  batteryIsCharging Boolean?              @map("battery_is_charging")
  /// 배터리 보고 시각
  batteryReportedAt DateTime?             @map("battery_reported_at") @db.Timestamptz(6)
  /// ACTIVE·REVOKED·UNPAIRED
  status            String                @default("ACTIVE") @db.VarChar(24)
  /// 페어링 코드 발급 관리자
  pairedBy          String                @map("paired_by") @db.VarChar(160)
  /// 페어링 시각
  pairedAt          DateTime              @default(now()) @map("paired_at") @db.Timestamptz(6)
  /// 마지막 상태 보고 시각(60초 간격 기록)
  lastHeartbeatAt   DateTime?             @map("last_heartbeat_at") @db.Timestamptz(6)
  /// 폐기 시각
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  /// 취소 주체
  revokedBy         String?               @map("revoked_by") @db.VarChar(160)
  /// 잠긴 회차 ID
  selectedSessionId BigInt?               @map("selected_session_id")
  /// 회차 잠금 시각
  scanModeLockedAt  DateTime?             @map("scan_mode_locked_at") @db.Timestamptz(6)
  /// 생성 시각
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 입장 이벤트
  checkInEvents     CheckInEvent[]
  /// 페어링 감사
  pairingAudits     ScannerPairingAudit[]
  /// 지점
  branch            Branch                @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 잠긴 회차
  selectedSession   SeminarSession?       @relation(fields: [selectedSessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, lastHeartbeatAt(sort: Desc)], map: "scanner_devices_status_heartbeat_idx")
  @@index([branchId, status], map: "scanner_devices_branch_status_idx")
  @@index([selectedSessionId], map: "scanner_devices_selected_session_idx")
  @@map("scanner_devices")
}

/// 스캐너 페어링·관리 감사. 기기 삭제 시 함께 삭제
