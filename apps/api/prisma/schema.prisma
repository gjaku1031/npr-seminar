  @@index([seminarId, startsAt], map: "seminar_sessions_seminar_starts_idx")
  @@index([branchId, startsAt], map: "seminar_sessions_branch_starts_idx")
  @@index([status, startsAt], map: "seminar_sessions_status_starts_idx")
  @@map("seminar_sessions")
}

/// OTP 확인 후 발급한 예약 증명
model OtpProofAudit {
  /// ID
  id                 BigInt          @id @default(autoincrement())
  /// 공개 ID
  publicId           String          @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  /// 증명 원문 SHA-256. 관리자 대리 증명은 null
  proofDigest        Bytes?          @unique @map("proof_digest") @db.ByteA
  /// FAMILY_BOOKING·BOOKING_MANAGE·ADMIN_OVERRIDE
  purpose            String          @db.VarChar(40)
  /// 연락처 HMAC 다이제스트
  contactDigest      Bytes           @map("contact_digest") @db.ByteA
  /// 연락처 암호문
  contactCiphertext  Bytes           @map("contact_ciphertext") @db.ByteA
  /// 연락처 끝 4자리
  contactLast4       String          @map("contact_last4") @db.Char(4)
  /// 선택 캠퍼스 코드. 관리 용도는 null
  selectedBranchCode String?         @map("selected_branch_code") @db.VarChar(32)
  /// VERIFIED 사용 가능, CONSUMED 사용됨
  status             String          @db.VarChar(24)
  /// 만료 시각
  expiresAt          DateTime        @map("expires_at") @db.Timestamptz(6)
  /// 확인 시각
  verifiedAt         DateTime?       @map("verified_at") @db.Timestamptz(6)
  /// 사용 시각
  consumedAt         DateTime?       @map("consumed_at") @db.Timestamptz(6)
  /// 생성 시각
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 이 증명으로 만든 예약
  familyBookings     FamilyBooking[]
  /// 원래 OTP 챌린지
  otpChallenges      OtpChallenge[]

  @@index([contactDigest, purpose, status], map: "otp_proof_audits_lookup_idx")
  @@map("otp_proof_audits")
}

/// OTP 챌린지
model OtpChallenge {
  /// ID
  id                 BigInt         @id @default(autoincrement())
  /// 공개 ID
  publicId           String         @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  /// 용도
  purpose            String         @db.VarChar(40)
  /// 연락처 HMAC 다이제스트
  contactDigest      Bytes          @map("contact_digest") @db.ByteA
  /// 연락처 암호문
  contactCiphertext  Bytes          @map("contact_ciphertext") @db.ByteA
  /// 연락처 끝 4자리
  contactLast4       String         @map("contact_last4") @db.Char(4)
  /// 선택 캠퍼스 코드. 관리 용도는 null
  selectedBranchCode String?        @map("selected_branch_code") @db.VarChar(32)
  /// 챌린지 ID+코드 HMAC. 코드 원문은 저장하지 않음
  codeDigest         Bytes          @map("code_digest") @db.ByteA
  /// PENDING·VERIFIED·EXPIRED·LOCKED
  status             String         @default("PENDING") @db.VarChar(24)
  /// 시도 횟수
  attemptCount       Int            @default(0) @map("attempt_count")
  /// 최대 시도 횟수
  maxAttempts        Int            @default(5) @map("max_attempts")
  /// 만료 시각
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz(6)
  /// 확인 시각
  verifiedAt         DateTime?      @map("verified_at") @db.Timestamptz(6)
  /// 발급한 예약 증명 ID
  otpProofAuditId    BigInt?        @unique @map("otp_proof_audit_id")
  /// 생성 시각
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 변경 시각
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// OTP 증명
  otpProofAudit      OtpProofAudit? @relation(fields: [otpProofAuditId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contactDigest, createdAt(sort: Desc)], map: "otp_challenges_contact_created_idx")
  @@index([status, expiresAt], map: "otp_challenges_status_expires_idx")
  @@map("otp_challenges")
}

/// 가족 단위 설명회 예약
model FamilyBooking {
  /// ID
  id                 BigInt                     @id @default(autoincrement())
  /// 공개 ID
  publicId           String                     @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  /// 회차 ID
  sessionId          BigInt                     @map("session_id")
  /// 보호자 연락처 HMAC 다이제스트
  contactDigest      Bytes                      @map("contact_digest") @db.ByteA
  /// 보호자 연락처 암호문
  contactCiphertext  Bytes                      @map("contact_ciphertext") @db.ByteA
  /// 보호자 연락처 끝 4자리
  contactLast4       String                     @map("contact_last4") @db.Char(4)
  /// 참석 보호자. MOTHER·FATHER·BOTH
  attendanceParty    String                     @map("attendance_party") @db.VarChar(16)
  /// 예약 인원. 참석 보호자 기준 1 또는 2
  seatCount          Int                        @map("seat_count")
  /// RESERVED·CHECKED_IN·CANCELLED·NO_SHOW
  status             String                     @default("RESERVED") @db.VarChar(24)
  /// 낙관적 잠금 버전
  version            BigInt                     @default(1)
  /// 예약 경로. WEB_APP·PHONE·TEACHER·ON_SITE
  bookingSource      String                     @default("WEB_APP") @map("booking_source") @db.VarChar(24)
  /// 예약에 쓴 OTP 증명 ID
  otpProofAuditId    BigInt                     @map("otp_proof_audit_id")
  /// 입장 시각
  checkedInAt        DateTime?                  @map("checked_in_at") @db.Timestamptz(6)
  /// 실제 입장한 보호자 수. 예약 인원(seatCount)과 다를 수 있어 게이트에서 스태프가 입력. 미입장이면 null
  attendedCount      Int?                       @map("attended_count")
  /// QR 재테스트용 예약 여부. 집계 확인을 위해 통계에는 포함하고 시트 반영·일반 문자 대상에서만 제외. 명단 맨 앞에 고정
  isTest             Boolean                    @default(false) @map("is_test")
  /// 취소 시각
  cancelledAt        DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  /// 생성 시각
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 변경 시각
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 회차
  session            SeminarSession             @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// OTP 증명
  otpProofAudit      OtpProofAudit              @relation(fields: [otpProofAuditId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 참가자
  students           FamilyBookingStudent[]
  /// QR 자격 증명
  qrCredentials      QrCredential[]
  /// 예약 이벤트
  bookingEvents      BookingEvent[]
  /// 입장 이벤트
  checkInEvents      CheckInEvent[]
  /// 관리 링크 자격 증명
  accessCredentials  BookingAccessCredential[]
  /// 예약 관리 세션
  managementSessions BookingManagementSession[]

  @@unique([id, sessionId], map: "family_bookings_id_session_unique")
  @@index([contactDigest, createdAt(sort: Desc), id(sort: Desc)], map: "family_bookings_contact_created_id_idx")
  @@index([sessionId, status], map: "family_bookings_session_status_idx")
  @@index([sessionId, contactLast4, status], map: "family_bookings_last4_active_idx")
  @@index([otpProofAuditId], map: "family_bookings_otp_proof_idx")
  @@index([sessionId, isTest], map: "family_bookings_session_test_idx")
  @@map("family_bookings")
}

/// 예약 참가자. 예약 시점 스냅샷 보관
model FamilyBookingStudent {
  /// ID
  id                      BigInt         @id @default(autoincrement())
  /// 공개 ID
  publicId                String         @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  /// 가족 예약 ID
  familyBookingId         BigInt         @map("family_booking_id")
  /// 회차 ID
  sessionId               BigInt         @map("session_id")
  /// 참여 유형. ENROLLED 재원생, GUEST 비재원생
  participantType         String         @default("ENROLLED") @map("participant_type") @db.VarChar(16)
  /// 학생 ID. 비재원생은 null
  studentId               BigInt?        @map("student_id")
  /// 현재 예약에 포함 여부
  active                  Boolean        @default(true)
  /// 예약에서 빠진 시각
  releasedAt              DateTime?      @map("released_at") @db.Timestamptz(6)
  /// 예약 시점 캠퍼스
  branchCodeAtBooking     String         @map("branch_code_at_booking") @db.VarChar(32)
  /// 학번 스냅샷. 비재원생은 `비재원-000001` 형식
  sourceStudentNoSnapshot String         @map("source_student_no_snapshot") @db.VarChar(160)
  /// 이름 스냅샷
  studentNameSnapshot     String         @map("student_name_snapshot") @db.VarChar(300)
  /// 반 스냅샷
  classNameSnapshot       String         @map("class_name_snapshot") @db.VarChar(300)
  /// 학교 스냅샷
  schoolNameSnapshot      String?        @map("school_name_snapshot") @db.VarChar(300)
  /// 학년 스냅샷
  gradeSnapshot           String?        @map("grade_snapshot") @db.VarChar(100)
  /// 단위 스냅샷
  unitNameSnapshot        String?        @map("unit_name_snapshot") @db.VarChar(160)
  /// 담임 스냅샷
  teacherNameSnapshot     String?        @map("teacher_name_snapshot") @db.VarChar(300)
  /// 생성 시각
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 가족 예약. 예약 ID와 회차 ID 복합 외래 키로 회차 일치 보장
  familyBooking           FamilyBooking  @relation(fields: [familyBookingId, sessionId], references: [id, sessionId], onDelete: NoAction, onUpdate: NoAction, map: "family_booking_students_family_session_fk")
  /// 회차
  session                 SeminarSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 학생 원장
  student                 Student?       @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([familyBookingId, studentId], map: "family_booking_students_family_student_unique")
  @@index([studentId], map: "family_booking_students_student_idx")
  @@index([sessionId, active], map: "family_booking_students_session_active_idx")
  @@map("family_booking_students")
}

/// 예약 QR 자격 증명
model QrCredential {
  /// ID
  id              BigInt         @id @default(autoincrement())
  /// 공개 ID
  publicId        String         @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  /// 가족 예약 ID
  familyBookingId BigInt         @map("family_booking_id")
  /// 토큰 SHA-256 다이제스트. 원문은 저장하지 않음
  tokenDigest     Bytes          @unique @map("token_digest") @db.ByteA
  /// QR 원문 암호문. 재표시용, 없으면 재표시 불가
  tokenCiphertext Bytes?         @map("token_ciphertext") @db.ByteA
  /// 예약 내 버전. 1부터
  version         Int
  /// ACTIVE·REVOKED·EXPIRED
  status          String         @db.VarChar(24)
  /// 발급 시각
  issuedAt        DateTime       @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// 만료 시각
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(6)
  /// 폐기 시각
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(6)
  /// 이 자격을 대체한 다음 자격 ID
  supersededById  BigInt?        @unique @map("superseded_by_id")
  /// 가족 예약
  familyBooking   FamilyBooking  @relation(fields: [familyBookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 대체한 자격
  predecessor     QrCredential?  @relation("credential_supersession", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 대체된 자격
  successor       QrCredential?  @relation("credential_supersession")
  /// 입장 이벤트
  checkInEvents   CheckInEvent[]

  @@unique([familyBookingId, version], map: "qr_credentials_booking_version_unique")
  @@index([familyBookingId, status], map: "qr_credentials_family_status_idx")
  @@map("qr_credentials")
}

/// 예약 관리 링크 자격 증명
