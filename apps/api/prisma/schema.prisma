  /// DRAFT·OPEN·CLOSED·CANCELLED·ARCHIVED
  status                String                 @default("DRAFT") @db.VarChar(24)
  /// 낙관적 잠금 버전
  version               BigInt                 @default(1)
  /// 생성 시각
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 변경 시각
