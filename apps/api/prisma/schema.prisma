  @@index([sessionId, occurredAt(sort: Desc), id(sort: Desc)], map: "check_in_events_session_occurred_idx")
  @@index([qrCredentialId], map: "check_in_events_credential_idx")
  @@index([scannerDeviceId], map: "check_in_events_scanner_idx")
  @@map("check_in_events")
}

/// 멱등 요청 기록. 24시간 보관
