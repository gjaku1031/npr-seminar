generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id              BigInt           @id @default(autoincrement())
  publicId        String           @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  code            String           @unique @db.VarChar(32)
  displayName     String           @map("display_name") @db.VarChar(80)
  sourceCode      String           @unique @map("source_code") @db.VarChar(32)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  students        Student[]
  syncBranchRuns  SyncBranchRun[]
  stagingStudents StagingStudent[]
  scannerDevices  ScannerDevice[]
  seminarSessions SeminarSession[]

  @@map("branches")
}

model AdminUser {
  id           BigInt      @id @default(autoincrement())
  publicId     String      @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  username     String      @unique @db.VarChar(120)
  passwordHash String      @map("password_hash") @db.Text
  displayName  String      @map("display_name") @db.VarChar(120)
  role         String      @db.VarChar(24)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  authAudits   AuthAudit[]

  @@map("admin_users")
}

model AuthAudit {
  id           BigInt     @id @default(autoincrement())
  eventId      String     @unique @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  adminUserId  BigInt?    @map("admin_user_id")
  actorSubject String?    @map("actor_subject") @db.VarChar(160)
  eventType    String     @map("event_type") @db.VarChar(40)
  resultCode   String     @map("result_code") @db.VarChar(80)
  safeMetadata Json       @default("{}") @map("safe_metadata") @db.JsonB
  occurredAt   DateTime   @default(now()) @map("occurred_at") @db.Timestamptz(6)
  adminUser    AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([adminUserId, occurredAt(sort: Desc)], map: "auth_audits_admin_user_id_occurred_at_idx")
  @@map("auth_audits")
}

model SyncRun {
  id                      BigInt                   @id @default(autoincrement())
  publicId                String                   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  runType                 String                   @map("run_type") @db.VarChar(32)
  status                  String                   @db.VarChar(40)
  initiatedBy             String?                  @map("initiated_by") @db.VarChar(160)
  snapshotId              String?                  @map("snapshot_id") @db.VarChar(80)
  snapshotHash            Bytes?                   @map("snapshot_hash") @db.ByteA
  stagingHash             Bytes?                   @map("staging_hash") @db.ByteA
  publishable             Boolean                  @default(false)
  loginAttempted          Boolean                  @default(false) @map("login_attempted")
  ambiguityCount          Int                      @default(0) @map("ambiguity_count")
  rawRowCount             Int                      @default(0) @map("raw_row_count")
  includedAssignmentCount Int                      @default(0) @map("included_assignment_count")
  uniqueStudentCount      Int                      @default(0) @map("unique_student_count")
  excludedCount           Int                      @default(0) @map("excluded_count")
  startedAt               DateTime                 @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt              DateTime?                @map("finished_at") @db.Timestamptz(6)
  publishedAt             DateTime?                @map("published_at") @db.Timestamptz(6)
  publishedBy             String?                  @map("published_by") @db.VarChar(160)
  errorCode               String?                  @map("error_code") @db.VarChar(100)
  metrics                 Json                     @default("{}") @db.JsonB
  branchRuns              SyncBranchRun[]
  stagingStudents         StagingStudent[]
  conflicts               SyncConflict[]
  studentFirstSeen        Student[]                @relation("student_first_seen")
  studentLastSeen         Student[]                @relation("student_last_seen")
  assignmentFirstSeen     StudentClassAssignment[] @relation("assignment_first_seen")
  assignmentLastSeen      StudentClassAssignment[] @relation("assignment_last_seen")
  studentHistory          StudentHistory[]
  circuitAudits           TongAuthCircuitAudit[]
  openedCircuits          TongAuthCircuit[]
  syncAuditEvents         SyncAuditEvent[]

  @@index([startedAt(sort: Desc), id(sort: Desc)], map: "sync_runs_started_at_idx")
  @@index([status, startedAt(sort: Desc)])
  @@map("sync_runs")
}

model SyncAuditEvent {
  id           BigInt   @id @default(autoincrement())
  eventId      String   @unique @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  syncRunId    BigInt   @map("sync_run_id")
  branchCode   String?  @map("branch_code") @db.VarChar(32)
  eventType    String   @map("event_type") @db.VarChar(40)
  actorSubject String   @map("actor_subject") @db.VarChar(160)
  counts       Json?    @db.JsonB
  errorCode    String?  @map("error_code") @db.VarChar(100)
  safeMetadata Json     @default("{}") @map("safe_metadata") @db.JsonB
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  syncRun      SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([syncRunId, id], map: "sync_audit_events_run_sequence_idx")
  @@index([occurredAt, id], map: "sync_audit_events_occurred_idx")
  @@map("sync_audit_events")
}

model SyncBranchRun {
  id               BigInt    @id @default(autoincrement())
  publicId         String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  syncRunId        BigInt    @map("sync_run_id")
  branchId         BigInt    @map("branch_id")
  sequenceNo       Int       @map("sequence_no") @db.SmallInt
  status           String    @db.VarChar(32)
  fetchedCount     Int       @default(0) @map("fetched_count")
  stagedCount      Int       @default(0) @map("staged_count")
  includedCount    Int       @default(0) @map("included_count")
  excludedCount    Int       @default(0) @map("excluded_count")
  insertedCount    Int       @default(0) @map("inserted_count")
  updatedCount     Int       @default(0) @map("updated_count")
  inactivatedCount Int       @default(0) @map("inactivated_count")
  snapshotHash     Bytes?    @map("snapshot_hash") @db.ByteA
  errorCode        String?   @map("error_code") @db.VarChar(100)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  syncRun          SyncRun   @relation(fields: [syncRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([syncRunId, branchId], map: "sync_branch_runs_run_branch_unique")
  @@unique([syncRunId, sequenceNo], map: "sync_branch_runs_run_sequence_unique")
  @@index([branchId, startedAt(sort: Desc)], map: "sync_branch_runs_branch_started_idx")
  @@map("sync_branch_runs")
}

model StagingStudent {
  id                    BigInt   @id @default(autoincrement())
  syncRunId             BigInt   @map("sync_run_id")
  branchId              BigInt   @map("branch_id")
  sourceOrdinal         Int      @map("source_ordinal")
  sourceUniqueNo        String   @map("source_unique_no") @db.VarChar(160)
  classRegistrationNo   String   @map("class_registration_no") @db.VarChar(160)
  sourceStudentNo       String?  @map("source_student_no") @db.VarChar(160)
  name                  String?  @db.VarChar(300)
  className             String?  @map("class_name") @db.VarChar(300)
  schoolName            String?  @map("school_name") @db.VarChar(300)
  grade                 String?  @db.VarChar(100)
  teacherName           String?  @map("teacher_name") @db.VarChar(300)
  unitName              String?  @map("unit_name") @db.VarChar(160)
  motherPhoneCiphertext Bytes?   @map("mother_phone_ciphertext") @db.ByteA
  motherPhoneDigest     Bytes?   @map("mother_phone_digest") @db.ByteA
  motherPhoneLast4      String?  @map("mother_phone_last4") @db.Char(4)
  fatherPhoneCiphertext Bytes?   @map("father_phone_ciphertext") @db.ByteA
  fatherPhoneDigest     Bytes?   @map("father_phone_digest") @db.ByteA
  fatherPhoneLast4      String?  @map("father_phone_last4") @db.Char(4)
  fatherPhoneObserved   Boolean  @default(false) @map("father_phone_observed")
  sourceStatus          String?  @map("source_status") @db.VarChar(100)
  rowHash               Bytes?   @map("row_hash") @db.ByteA
  included              Boolean
  exclusionReason       String?  @map("exclusion_reason") @db.VarChar(100)
  primaryCandidate      Boolean  @default(false) @map("primary_candidate")
  primarySelected       Boolean  @default(false) @map("primary_selected")
  classResolutionStatus String?  @map("class_resolution_status") @db.VarChar(40)
  classResolutionReason String?  @map("class_resolution_reason") @db.VarChar(80)
  stagedAt              DateTime @default(now()) @map("staged_at") @db.Timestamptz(6)
  syncRun               SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([syncRunId, branchId, sourceOrdinal], map: "staging_students_run_ordinal_unique")
  @@unique([syncRunId, branchId, sourceUniqueNo, classRegistrationNo], map: "staging_students_source_assignment_unique")
  @@index([syncRunId, sourceStudentNo], map: "staging_students_run_student_idx")
  @@index([syncRunId, branchId, included], map: "staging_students_run_branch_included_idx")
  @@index([branchId], map: "staging_students_branch_fk_idx")
  @@map("staging_students")
}

model SyncConflict {
  id              BigInt   @id @default(autoincrement())
  syncRunId       BigInt   @map("sync_run_id")
  conflictType    String   @map("conflict_type") @db.VarChar(80)
  branchCode      String?  @map("branch_code") @db.VarChar(32)
  sourceStudentNo String?  @map("source_student_no") @db.VarChar(160)
  safeDetails     Json     @default("{}") @map("safe_details") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  syncRun         SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([syncRunId, conflictType], map: "sync_conflicts_run_type_idx")
  @@map("sync_conflicts")
}

model TongAuthCircuit {
  singletonId      Int       @id @map("singleton_id") @db.SmallInt
  status           String    @db.VarChar(16)
  openedAt         DateTime? @map("opened_at") @db.Timestamptz(6)
  openedReasonCode String?   @map("opened_reason_code") @db.VarChar(100)
  openedRunId      BigInt?   @map("opened_run_id")
  lastResetAt      DateTime? @map("last_reset_at") @db.Timestamptz(6)
  lastResetBy      String?   @map("last_reset_by") @db.VarChar(160)
  version          BigInt    @default(0)
  openedRun        SyncRun?  @relation(fields: [openedRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([openedRunId], map: "tong_auth_circuit_opened_run_fk_idx")
  @@map("tong_auth_circuit")
}

model TongAuthCircuitAudit {
  id           BigInt   @id @default(autoincrement())
  eventId      String   @unique @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  syncRunId    BigInt?  @map("sync_run_id")
  eventType    String   @map("event_type") @db.VarChar(24)
  actorSubject String   @map("actor_subject") @db.VarChar(160)
  reasonCode   String   @map("reason_code") @db.VarChar(100)
  reason       String?  @db.Text
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  syncRun      SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([syncRunId], map: "tong_auth_circuit_audits_run_idx")
  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "tong_auth_circuit_audits_occurred_idx")
  @@map("tong_auth_circuit_audits")
}

model SyncLease {
  lockName          String    @id @map("lock_name") @db.VarChar(100)
  holderRunPublicId String?   @map("holder_run_public_id") @db.Uuid
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("sync_leases")
}

model Student {
  id                    BigInt                   @id @default(autoincrement())
  publicId              String                   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  sourceStudentNo       String                   @unique @map("source_student_no") @db.VarChar(160)
  branchId              BigInt                   @map("branch_id")
  name                  String                   @db.VarChar(300)
  className             String                   @map("class_name") @db.VarChar(300)
  schoolName            String?                  @map("school_name") @db.VarChar(300)
  grade                 String?                  @db.VarChar(100)
  teacherName           String?                  @map("teacher_name") @db.VarChar(300)
  unitName              String?                  @map("unit_name") @db.VarChar(160)
  motherPhoneCiphertext Bytes?                   @map("mother_phone_ciphertext") @db.ByteA
  motherPhoneDigest     Bytes?                   @map("mother_phone_digest") @db.ByteA
  motherPhoneLast4      String?                  @map("mother_phone_last4") @db.Char(4)
  fatherPhoneCiphertext Bytes?                   @map("father_phone_ciphertext") @db.ByteA
  fatherPhoneDigest     Bytes?                   @map("father_phone_digest") @db.ByteA
  fatherPhoneLast4      String?                  @map("father_phone_last4") @db.Char(4)
  sourceStatus          String?                  @map("source_status") @db.VarChar(100)
  sourceActive          Boolean                  @default(true) @map("source_active")
  sourceHash            Bytes                    @map("source_hash") @db.ByteA
  classResolutionStatus String                   @default("ONE_REGULAR") @map("class_resolution_status") @db.VarChar(40)
  classResolutionReason String?                  @map("class_resolution_reason") @db.VarChar(80)
  firstSeenRunId        BigInt                   @map("first_seen_run_id")
  lastSeenRunId         BigInt                   @map("last_seen_run_id")
  sourceInactivatedAt   DateTime?                @map("source_inactivated_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch                Branch                   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  firstSeenRun          SyncRun                  @relation("student_first_seen", fields: [firstSeenRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastSeenRun           SyncRun                  @relation("student_last_seen", fields: [lastSeenRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments           StudentClassAssignment[]
  history               StudentHistory[]
  bookingLinks          FamilyBookingStudent[]

  @@index([branchId, sourceActive, id], map: "students_branch_active_id_idx")
  @@index([motherPhoneDigest], map: "students_mother_digest_idx")
  @@index([motherPhoneLast4, branchId], map: "students_mother_last4_branch_idx")
  @@index([fatherPhoneDigest], map: "students_father_digest_idx")
  @@index([fatherPhoneLast4, branchId], map: "students_father_last4_branch_idx")
  @@index([lastSeenRunId], map: "students_last_seen_run_idx")
  @@index([firstSeenRunId], map: "students_first_seen_run_fk_idx")
  @@map("students")
}

model StudentClassAssignment {
  id                  BigInt    @id @default(autoincrement())
  publicId            String    @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  studentId           BigInt    @map("student_id")
  sourceUniqueNo      String    @map("source_unique_no") @db.VarChar(160)
  classRegistrationNo String    @map("class_registration_no") @db.VarChar(160)
  className           String    @map("class_name") @db.VarChar(300)
  teacherName         String?   @map("teacher_name") @db.VarChar(300)
  unitName            String?   @map("unit_name") @db.VarChar(160)
  schoolName          String?   @map("school_name") @db.VarChar(300)
  grade               String?   @db.VarChar(100)
  sourceHash          Bytes     @map("source_hash") @db.ByteA
  sourceActive        Boolean   @default(true) @map("source_active")
  firstSeenRunId      BigInt    @map("first_seen_run_id")
  lastSeenRunId       BigInt    @map("last_seen_run_id")
  sourceInactivatedAt DateTime? @map("source_inactivated_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student             Student   @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  firstSeenRun        SyncRun   @relation("assignment_first_seen", fields: [firstSeenRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastSeenRun         SyncRun   @relation("assignment_last_seen", fields: [lastSeenRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studentId, sourceUniqueNo, classRegistrationNo], map: "student_assignments_source_unique")
  @@index([studentId, sourceActive, className], map: "student_assignments_student_active_idx")
  @@index([lastSeenRunId], map: "student_assignments_last_seen_idx")
  @@index([firstSeenRunId], map: "student_assignments_first_seen_run_fk_idx")
  @@map("student_class_assignments")
}

model StudentHistory {
  id                    BigInt   @id @default(autoincrement())
  studentId             BigInt   @map("student_id")
  syncRunId             BigInt   @map("sync_run_id")
  changeType            String   @map("change_type") @db.VarChar(32)
  previousSnapshot      Json?    @map("previous_snapshot") @db.JsonB
  currentSnapshot       Json?    @map("current_snapshot") @db.JsonB
  fatherPhoneCiphertext Bytes?   @map("father_phone_ciphertext") @db.ByteA
  fatherPhoneDigest     Bytes?   @map("father_phone_digest") @db.ByteA
  fatherPhoneLast4      String?  @map("father_phone_last4") @db.Char(4)
  recordedAt            DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  student               Student  @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  syncRun               SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentId, recordedAt(sort: Desc), id(sort: Desc)], map: "student_history_student_recorded_idx")
  @@index([syncRunId], map: "student_history_run_idx")
  @@map("student_history")
}

model Seminar {
  id          BigInt           @id @default(autoincrement())
  publicId    String           @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  title       String           @db.VarChar(300)
  description String?          @db.Text
  status      String           @default("DRAFT") @db.VarChar(24)
  version     BigInt           @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions    SeminarSession[]

  @@map("seminars")
}

model SeminarSession {
  id                    BigInt                 @id @default(autoincrement())
  publicId              String                 @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  seminarId             BigInt                 @map("seminar_id")
  scope                 String                 @default("ALL") @db.VarChar(16)
  branchId              BigInt?                @map("branch_id")
  title                 String                 @db.VarChar(300)
  place                 String                 @db.VarChar(300)
  startsAt              DateTime               @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime               @map("ends_at") @db.Timestamptz(6)
  bookingOpensAt        DateTime?              @map("booking_opens_at") @db.Timestamptz(6)
  bookingClosesAt       DateTime?              @map("booking_closes_at") @db.Timestamptz(6)
  guestBookingEnabled   Boolean                @default(false) @map("guest_booking_enabled")
  status                String                 @default("DRAFT") @db.VarChar(24)
  version               BigInt                 @default(1)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  seminar               Seminar                @relation(fields: [seminarId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  familyBookings        FamilyBooking[]
  familyBookingStudents FamilyBookingStudent[]
  checkInEvents         CheckInEvent[]
  surveyResponses       SurveyResponse[]
  scannerDevices        ScannerDevice[]

  @@index([seminarId, startsAt], map: "seminar_sessions_seminar_starts_idx")
  @@index([branchId, startsAt], map: "seminar_sessions_branch_starts_idx")
  @@index([status, startsAt], map: "seminar_sessions_status_starts_idx")
  @@map("seminar_sessions")
}

model OtpProofAudit {
  id                 BigInt          @id @default(autoincrement())
  publicId           String          @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  proofDigest        Bytes?          @unique @map("proof_digest") @db.ByteA
  purpose            String          @db.VarChar(40)
  contactDigest      Bytes           @map("contact_digest") @db.ByteA
  contactCiphertext  Bytes           @map("contact_ciphertext") @db.ByteA
  contactLast4       String          @map("contact_last4") @db.Char(4)
  selectedBranchCode String?         @map("selected_branch_code") @db.VarChar(32)
  status             String          @db.VarChar(24)
  expiresAt          DateTime        @map("expires_at") @db.Timestamptz(6)
  verifiedAt         DateTime?       @map("verified_at") @db.Timestamptz(6)
  consumedAt         DateTime?       @map("consumed_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  familyBookings     FamilyBooking[]
  otpChallenges      OtpChallenge[]

  @@index([contactDigest, purpose, status], map: "otp_proof_audits_lookup_idx")
  @@map("otp_proof_audits")
}

model OtpChallenge {
  id                 BigInt         @id @default(autoincrement())
  publicId           String         @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  purpose            String         @db.VarChar(40)
  contactDigest      Bytes          @map("contact_digest") @db.ByteA
  contactCiphertext  Bytes          @map("contact_ciphertext") @db.ByteA
  contactLast4       String         @map("contact_last4") @db.Char(4)
  selectedBranchCode String?        @map("selected_branch_code") @db.VarChar(32)
  codeDigest         Bytes          @map("code_digest") @db.ByteA
  status             String         @default("PENDING") @db.VarChar(24)
  attemptCount       Int            @default(0) @map("attempt_count")
  maxAttempts        Int            @default(5) @map("max_attempts")
  expiresAt          DateTime       @map("expires_at") @db.Timestamptz(6)
  verifiedAt         DateTime?      @map("verified_at") @db.Timestamptz(6)
  otpProofAuditId    BigInt?        @unique @map("otp_proof_audit_id")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  otpProofAudit      OtpProofAudit? @relation(fields: [otpProofAuditId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contactDigest, createdAt(sort: Desc)], map: "otp_challenges_contact_created_idx")
  @@index([status, expiresAt], map: "otp_challenges_status_expires_idx")
  @@map("otp_challenges")
