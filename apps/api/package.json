{
  "name": "@npr-seminar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "bash ./scripts/with-prisma-client-lock.sh ./node_modules/.bin/nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:worker": "PROCESS_ROLE=worker node dist/worker.js",
    "typecheck": "bash ./scripts/with-prisma-client-lock.sh ./node_modules/.bin/tsc --noEmit",
    "lint": "bash ./scripts/with-prisma-client-lock.sh ./node_modules/.bin/tsc --noEmit",
    "test": "bash ./scripts/with-prisma-client-lock.sh ./node_modules/.bin/vitest run",
    "test:watch": "vitest",
    "test:integration": "bash ./scripts/with-prisma-client-lock.sh ./node_modules/.bin/vitest run --config vitest.integration.config.ts",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "bash ./scripts/with-prisma-client-lock.sh",
    "db:generate": "bash ./scripts/with-prisma-client-lock.sh",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node dist/commands/bootstrap-admin.js",
    "db:studio": "prisma studio",
    "migrate:deploy": "prisma migrate deploy",
    "snapshot:dry-run": "node dist/commands/offline-snapshot.js dry-run",
    "snapshot:publish": "node dist/commands/offline-snapshot.js publish"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/throttler": "6.4.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "connect-redis": "9.0.0",
    "exceljs": "4.4.0",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "iconv-lite": "0.7.3",
    "pg": "8.16.3",
    "redis": "5.8.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.5",
    "@types/express-session": "1.18.2",
    "@types/node": "22.18.11",
    "@types/pg": "8.15.6",
    "prisma": "7.8.0",
    "testcontainers": "11.7.2",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
